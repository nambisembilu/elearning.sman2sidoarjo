# Variabel produksi untuk Coolify (tab Environment Variables).
# Salin nilai ini ke Coolify, JANGAN commit nilai asli ke git.

# --- Aplikasi ---
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# --- Database (harus cocok dengan service db / managed database) ---
DB_HOST=db
DB_PORT=3306
DB_USER=elearning
DB_PASSWORD=ganti-password-kuat
# Biarkan elearning_sma agar cocok dengan database/elearning_sma.sql
DB_NAME=elearning_sma
# Password root MySQL (dipakai container db saat pertama kali init)
DB_ROOT_PASSWORD=ganti-root-password-kuat

# --- Keamanan ---
# WAJIB diganti: string acak panjang (mis. `openssl rand -hex 32`)
JWT_SECRET=ganti-dengan-string-acak-panjang

# --- CORS ---
# Kosongkan jika frontend + API satu domain (default single container).
# Isi hanya bila API diakses dari domain lain, dipisah koma.
CLIENT_ORIGIN=

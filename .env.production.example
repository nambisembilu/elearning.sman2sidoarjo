# Environment variables produksi — isikan di Coolify (tab Environment Variables).
# Deploy memakai Dockerfile saja + MySQL managed database Coolify.
# JANGAN commit nilai asli ke git.

# --- Aplikasi ---
# NODE_ENV, HOST, PORT sudah punya default di Dockerfile (production/0.0.0.0/4000).
# Cukup override bila perlu.
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# --- Database (arahkan ke MySQL managed Coolify) ---
# Ambil host/port/user/password dari halaman database di Coolify.
# Gunakan nama service internal Coolify sebagai DB_HOST (bukan localhost).
DB_HOST=nama-service-mysql-di-coolify
DB_PORT=3306
DB_USER=elearning
DB_PASSWORD=ganti-password-kuat
# Pertahankan elearning_sma agar cocok dengan database/elearning_sma.sql
DB_NAME=elearning_sma

# --- Migrasi otomatis ---
# true (default): server meng-import database/elearning_sma.sql saat startup
#   (idempoten). Set false bila skema dikelola manual.
AUTO_MIGRATE=true

# --- Keamanan ---
# WAJIB diganti: string acak panjang, mis. `openssl rand -hex 32`
JWT_SECRET=ganti-dengan-string-acak-panjang

# --- CORS ---
# Kosongkan jika frontend + API satu domain (default single container).
# Isi hanya bila API diakses dari domain lain (pisah koma).
CLIENT_ORIGIN=
